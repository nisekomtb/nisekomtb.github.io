{
  "name": "nisekomtb.github.io",
  "private": true,
  "description": "Dev-only minifier dependencies for the GitHub Pages deploy workflow. Source files in this repo are not built or bundled with Node; these tools run at deploy time (.github/workflows/deploy.yml) against the Jekyll output.",
  "scripts": {
    "minify:css": "find _site -type f -name '*.css' ! -name '*.min.css' -exec sh -c 'npx lightningcss --minify --error-recovery --browserslist \"$1\" -o \"$1.tmp\" && mv \"$1.tmp\" \"$1\"' _ {} \\;",
    "minify:js": "find _site -type f -name '*.js' ! -name '*.min.js' -exec sh -c 'npx terser \"$1\" -c -m -o \"$1\"' _ {} \\;",
    "minify:html": "find _site -type f -name '*.html' -exec npx html-minifier-terser --collapse-whitespace --conservative-collapse --remove-comments --remove-redundant-attributes --remove-script-type-attributes --remove-style-link-type-attributes --use-short-doctype -o {} {} \\;"
  },
  "devDependencies": {
    "lightningcss-cli": "^1.30.1",
    "terser": "^5.36.0",
    "html-minifier-terser": "^7.2.0"
  }
}
